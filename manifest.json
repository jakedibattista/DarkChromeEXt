{
  "manifest_version": 3,
  "name": "Dark Mode",
  "version": "1.0",
  "description": "Applies dark mode best practices to websites",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["darkmode.css"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/small.jpg",
      "48": "icons/med.jpg",
      "128": "icons/large.jpg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/small.jpg",
    "48": "icons/med.jpg",
    "128": "icons/large.jpg"
  }
}
